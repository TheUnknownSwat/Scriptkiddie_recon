# SQLite database location.
# RELATIVE path — Prisma resolves it from the prisma/ folder, so ../db/
# puts the DB at <project-root>/db/webrecon.db on BOTH Linux and Windows.
DATABASE_URL=file:../db/webrecon.db

# --- Optional feature flags (uncomment to enable) ---

# Auto-install playwright + chromium on first scan if missing (needs internet).
# WEBRECON_AUTO_INSTALL_PLAYWRIGHT=1

# External supervisor: restarts the scanner if it freezes (heartbeat >180s).
# WEBRECON_SUPERVISOR=1
# WEBRECON_SUPERVISOR_THRESHOLD=180

# Disable all in-process watchdogs (debugging only — a truly hung scan will
# freeze forever with this on).
# WEBRECON_DISABLE_WATCHDOG=1

# LLM request timeout in ms (default 120000).
# WEBRECON_LLM_TIMEOUT_MS=120000

# Throttle between LLM calls in ms (default 0 — no throttle).
# WEBRECON_LLM_THROTTLE_MS=0

# Override the LLM max-token budget everywhere: env > Settings > default 4000.
# Applies to the scanner subprocess AND every web LLM route.
# WEBRECON_LLM_MAX_TOKENS=16192
